---
import { productHelpers } from '../lib/site.js';
import StoreLinks from './StoreLinks.astro';
const {language}=Astro.props;
const {stCopy,stAsset,stRoutePath,stStoreLinks}=productHelpers(language);
const landing=stCopy('landing');
const copy=key=>landing[key]??key;
const showcase=[['today',copy('todayAlt'),copy('uiTodaySaving'),'today'],['plans',copy('plansAlt'),copy('plansKicker'),'plans'],['planDetail',copy('detailAlt'),copy('uiPlanDetail'),'detail'],['calendar',copy('calendarAlt'),copy('progressKicker'),'calendar'],['settings',language==='es'?'Ajustes de SaveTempo con preferencias locales.':'SaveTempo Settings with local preferences.',copy('uiSettings'),'settings']];
const resources=[['week52','52','week52ResourceTitle','week52ResourceBody'],['day365','365','day365ResourceTitle','day365ResourceBody'],['challengeApp','APP','appResourceTitle','appResourceBody']];
---
    <section class="hero product-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
            <p class="section-kicker">{copy('eyebrow')}</p>
            <h1 id="hero-title">{copy('heroTitle')}</h1>
            <p class="hero-lede">{copy('heroBody')}</p>
            <div class="hero-actions" id="download">
                {stStoreLinks().length === 0 ? (<>
                    <span class="availability-pill"><i aria-hidden="true"></i>{stCopy('chrome.availableSoon', language)}</span>
                </>) : (<>
                    <StoreLinks language={language} />
                </>)}
                <a class="product-button product-button-secondary" href="#how-it-works">{copy('heroCta')} <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hero-note">{copy('heroNote')}</p>
        </div>
        <div class="hero-visual" aria-label={copy('uiAppPreview')}>
            <div class="ambient-orb ambient-orb-one" aria-hidden="true"></div>
            <div class="ambient-orb ambient-orb-two" aria-hidden="true"></div>
            <div class="hero-brand-chip">
                <img src={stAsset('icon')} alt="" width="56" height="56" decoding="async">
                <span><strong>SaveTempo</strong>{copy('moneyTitle')}</span>
            </div>
            <figure class="phone phone-hero product-phone-frame">
                <div class="phone-speaker" aria-hidden="true"></div>
                <img class="product-phone-screenshot" src={stAsset('today')} alt={copy('heroAlt')} width="540" height="960" fetchpriority="high" decoding="async">
            </figure>
            <div class="tempo-card" aria-hidden="true">
                <span>{copy('uiYourTempo')}</span>
                <strong>8 / 10</strong>
                <i><b></b></i>
            </div>
        </div>
    </section>

    <section class="idea-section product-shell" aria-labelledby="idea-title">
        <div class="editorial-heading">
            <p class="section-kicker">{copy('ideaKicker')}</p>
            <h2 id="idea-title">{copy('ideaTitle')}</h2>
        </div>
        <div class="idea-copy">
            <p>{copy('ideaBody')}</p>
            <aside class="money-statement">
                <span aria-hidden="true">↘</span>
                <h3>{copy('moneyTitle')}</h3>
                <p>{copy('moneyBody')}</p>
            </aside>
        </div>
    </section>

    <section class="how-section" id="how-it-works" aria-labelledby="how-title">
        <div class="product-shell">
            <div class="section-heading-wide">
                <p class="section-kicker">{copy('howKicker')}</p>
                <h2 id="how-title">{copy('howTitle')}</h2>
            </div>
            <ol class="steps">
                <li>
                    <span>01</span>
                    <div><h3>{copy('step1Title')}</h3><p>{copy('step1Body')}</p></div>
                </li>
                <li>
                    <span>02</span>
                    <div><h3>{copy('step2Title')}</h3><p>{copy('step2Body')}</p></div>
                </li>
                <li>
                    <span>03</span>
                    <div><h3>{copy('step3Title')}</h3><p>{copy('step3Body')}</p></div>
                </li>
            </ol>
        </div>
    </section>

    <div id="features">
        <section class="feature feature-today product-shell" aria-labelledby="today-title">
            <div class="feature-copy">
                <p class="section-kicker">{copy('todayKicker')}</p>
                <h2 id="today-title">{copy('todayTitle')}</h2>
                <p>{copy('todayBody')}</p>
                <ul class="inline-facts" aria-label={copy('uiHome')}>
                    <li>{copy('uiTodaySaving')}</li><li>{copy('uiPendingSavings')}</li><li>{copy('uiYourTempo')}</li><li>{copy('uiActivePlans')}</li>
                </ul>
            </div>
            <div class="feature-visual offset-phone-stage">
                <figure class="phone phone-feature product-phone-frame">
                    <div class="phone-speaker" aria-hidden="true"></div>
                    <img class="product-phone-screenshot" src={stAsset('today')} alt={copy('todayAlt')} width="540" height="960" loading="lazy" decoding="async">
                </figure>
                <div class="pulse-note" aria-hidden="true"><span>{copy('uiToday')}</span><strong>{copy('uiClearConcreteYours')}</strong></div>
            </div>
        </section>

        <section class="feature-plans" aria-labelledby="plans-title">
            <div class="product-shell feature-plans-grid">
                <div class="plans-visual">
                    <figure class="phone phone-feature phone-plans product-phone-frame">
                        <div class="phone-speaker" aria-hidden="true"></div>
                        <img class="product-phone-screenshot" src={stAsset('plans')} alt={copy('plansAlt')} width="540" height="960" loading="lazy" decoding="async">
                    </figure>
                    <div class="plan-label plan-label-week"><span>52</span><p>{copy('weekPlan')}<small>{copy('weekMeta')}</small></p></div>
                    <div class="plan-label plan-label-day"><span>365</span><p>{copy('dayPlan')}<small>{copy('dayMeta')}</small></p></div>
                </div>
                <div class="feature-copy">
                    <p class="section-kicker">{copy('plansKicker')}</p>
                    <h2 id="plans-title">{copy('plansTitle')}</h2>
                    <p>{copy('plansBody')}</p>
                    <div class="pattern-line" aria-label={copy('uiSavingPatterns')}><span>{copy('uiIncreasing')}</span><i></i><span>{copy('uiRandom')}</span></div>
                </div>
            </div>
        </section>

        <section class="progress-section product-shell" aria-labelledby="progress-title">
            <div class="section-heading-wide progress-heading">
                <div>
                    <p class="section-kicker">{copy('progressKicker')}</p>
                    <h2 id="progress-title">{copy('progressTitle')}</h2>
                </div>
                <p>{copy('progressBody')}</p>
            </div>
            <div class="dual-phones">
                <figure class="phone phone-feature phone-detail product-phone-frame">
                    <div class="phone-speaker" aria-hidden="true"></div>
                    <img class="product-phone-screenshot" src={stAsset('planDetail')} alt={copy('detailAlt')} width="540" height="960" loading="lazy" decoding="async">
                </figure>
                <figure class="phone phone-feature phone-calendar product-phone-frame">
                    <div class="phone-speaker" aria-hidden="true"></div>
                    <img class="product-phone-screenshot" src={stAsset('calendar')} alt={copy('calendarAlt')} width="540" height="960" loading="lazy" decoding="async">
                </figure>
                <div class="calendar-legend" aria-label={copy('uiCalendarStatuses')}>
                    <span><i class="saved"></i>{copy('uiSaved')}</span>
                    <span><i class="partial"></i>{copy('uiPartial')}</span>
                    <span><i class="pending"></i>{copy('uiPending')}</span>
                    <span><i class="upcoming"></i>{copy('uiUpcoming')}</span>
                </div>
            </div>
        </section>

        <section class="reminders-section" aria-labelledby="reminders-title">
            <div class="product-shell reminders-grid">
                <div class="feature-copy reminders-copy">
                    <p class="section-kicker">{copy('remindersKicker')}</p>
                    <h2 id="reminders-title">{copy('remindersTitle')}</h2>
                    <p>{copy('remindersBody')}</p>
                    <div class="notification-sample" aria-hidden="true">
                        <img src={stAsset('icon')} alt="" width="40" height="40" loading="lazy">
                        <p><strong>SaveTempo</strong><span>{copy('uiNotification')}</span></p>
                        <small>{copy('uiNow')}</small>
                    </div>
                </div>
                <figure class="phone phone-feature phone-reminders product-phone-frame">
                    <div class="phone-speaker" aria-hidden="true"></div>
                    <img class="product-phone-screenshot" src={stAsset('reminders')} alt={copy('remindersAlt')} width="540" height="960" loading="lazy" decoding="async">
                </figure>
            </div>
        </section>
    </div>

    <section class="privacy-section product-shell" aria-labelledby="privacy-title">
        <div class="privacy-mark" aria-hidden="true">
            <span></span><span></span><span></span>
            <b>LOCAL</b>
        </div>
        <div class="feature-copy">
            <p class="section-kicker">{copy('privacyKicker')}</p>
            <h2 id="privacy-title">{copy('privacyTitle')}</h2>
            <p>{copy('privacyBody')}</p>
            <ul class="privacy-facts">
                {(landing.privacyFacts ?? []).map(fact => (<><li><span aria-hidden="true">✓</span>{fact}</li></>))}
            </ul>
            <a class="text-link" href={stRoutePath('privacy', language)}>{copy('privacyCta')} <span aria-hidden="true">↗</span></a>
        </div>
    </section>

    <section class="showcase-section" aria-labelledby="showcase-title">
        <div class="product-shell">
            <div class="section-heading-wide showcase-heading">
                <p class="section-kicker">{copy('showcaseKicker')}</p>
                <h2 id="showcase-title">{copy('showcaseTitle')}</h2>
                <p>{copy('showcaseBody')}</p>
            </div>
            <div class="showcase-track" tabindex="0" aria-label={copy('showcaseKicker')} data-showcase-track>
                {showcase.map(item => (<>
                    <figure class={`showcase-item showcase-item--${item[3]}`}>
                        <div class="showcase-phone product-phone-frame"><img class="product-phone-screenshot" src={stAsset(item[0])} alt={item[1]} width="540" height="960" loading="lazy" decoding="async"></div>
                        <figcaption>{item[2]}</figcaption>
                    </figure>
                </>))}
            </div>
        </div>
    </section>

    <section class="resources-section product-shell" aria-labelledby="resources-title">
        <div class="section-heading-wide">
            <div>
                <p class="section-kicker">{copy('resourcesKicker')}</p>
                <h2 id="resources-title">{copy('resourcesTitle')}</h2>
            </div>
            <p>{copy('resourcesBody')}</p>
        </div>
        <div class="resource-cards">
            {resources.map(([page,number,titleKey,bodyKey]) => (<>
                <article>
                    <span>{number}</span>
                    <h3>{copy(titleKey)}</h3>
                    <p>{copy(bodyKey)}</p>
                    <a href={stRoutePath(page, language)}>{copy('resourceCta')} <i aria-hidden="true">↗</i></a>
                </article>
            </>))}
        </div>
    </section>

    <section class="faq-section product-shell" aria-labelledby="faq-title">
        <div class="faq-heading">
            <p class="section-kicker">{copy('faqKicker')}</p>
            <h2 id="faq-title">{copy('faqTitle')}</h2>
        </div>
        <div class="faq-list">
            {(landing.faq ?? []).map((faq,index) => (<>
                <details open={index === 0}>
                    <summary>{(faq[0] ?? '')}</summary>
                    <p>{(faq[1] ?? '')}</p>
                </details>
            </>))}
        </div>
    </section>

    <section class="final-cta product-shell" aria-labelledby="final-title">
        <div>
            <img src={stAsset('icon')} alt="" width="80" height="80" loading="lazy" decoding="async">
            <p class="section-kicker">SaveTempo</p>
            <h2 id="final-title">{copy('finalTitle')}</h2>
            <p>{copy('finalBody')}</p>
            {stStoreLinks().length === 0 ? (<>
                <span class="availability-pill"><i aria-hidden="true"></i>{stCopy('chrome.availableSoon', language)}</span>
            </>) : (<>
                <StoreLinks language={language} />
            </>)}
            <a class="product-button product-button-secondary" href="#features">{copy('finalCta')} <span aria-hidden="true">↑</span></a>
        </div>
    </section>
